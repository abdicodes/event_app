# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Shared staff login password. Use a long unique value.
STAFF_PASSWORD=change-this-to-a-long-random-password

# At least 32 characters. Example: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters

# Local/LAN HTTP testing only. Keep false locally if you access the dev server by LAN IP.
# On Vercel, omit this variable or set it to true so cookies require HTTPS.
SESSION_COOKIE_SECURE=false

NEXT_PUBLIC_APP_NAME=GuestFlow

# Production URL used inside printed QR codes. Set this on Vercel to your stable HTTPS domain.
# Example: https://guestflow.example.org
